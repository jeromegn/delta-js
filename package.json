{
  "name": "deltalake",
  "version": "0.0.1-1",
  "repository": "https://github.com/jeromegn/delta-js.git",
  "license": "Apache-2.0",
  "keywords": [
    "delta",
    "deltalake",
    "data-processing",
    "rust"
  ],
  "main": "build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">= 20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --dts native.d.ts --js native.js -o delta --esm",
    "build:debug": "napi build --platform --dts native.d.ts --js native.js && npm run build:ts",
    "build:ts": " rm -rf build/; tsc -p tsconfig.build.json",
    "build:doc": "typedoc --excludeInternal delta/index.ts",
    "prepublishOnly": "napi prepublish -t npm",
    "universal": "napi universal",
    "version": "napi version",
    "test": "vitest run"
  },
  "dependencies": {
    "apache-arrow": "^19.0.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.0.0-alpha.91",
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "napi": {
    "binaryName": "deltalake",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu"
    ]
  }
}
